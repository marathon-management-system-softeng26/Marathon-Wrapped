  "narrative": {
    "northStar": "Existing Figma Make visual world",
    "overview": "The existing Figma Make visual world is the authority: an immersive race-red field, cream statistic panels, lime emphasis and expressive Bricolage lettering. The recap uses Experience mode; sign-in, runner selection and organizer management use Operate mode with cream surfaces, readable forms and red actions.\n\nThe world is typographic and flat. Large race measurements, a split chart, photographic moments and a final keepsake give the story its rhythm. The reference portrait is not copied; the introduction uses type and color. Existing stock photography remains explicitly simulated and attributed.",
    "keyCharacteristics": [
      "Race red, cream and lime carry identity across both modes.",
      "Bricolage display type pairs with familiar system sans body text.",
      "Flat panels and generous numeric scale create hierarchy.",
      "Direct progress buttons and visible focus keep the story navigable."
    ],
    "rules": [
      {
        "name": "The Existing World Rule",
        "body": "Extend the supplied visual world; do not replace its palette or display character.",
        "section": "colors"
      },
      {
        "name": "The Display Ceiling Rule",
        "body": "Interface display type stops at 6rem and tracking stays at or above -0.04em. The exported canvas has its own pixel scale.",
        "section": "typography"
      },
      {
        "name": "The Flat Panel Rule",
        "body": "Use color contrast and spacing to establish depth; existing panels have no box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do inherit the pinned Figma Make world when extending the interface.",
      "Do use locally hosted Bricolage for display type and system sans for Operate body text.",
      "Do keep measured values legible, with tabular numerals in statistic panels and tables.",
      "Do keep stock-photo attribution and visible simulated-data labels.",
      "Do respect reduced-motion preferences."
    ],
    "donts": [
      "Don't replace the established red, cream and lime world with a new identity.",
      "Don't copy the source-reference portrait or commit the read-only reference export.",
      "Don't invent hydration, missing timing or a live Strava connection.",
      "Don't add decorative shadows to the flat panel system."
    ]
  }
