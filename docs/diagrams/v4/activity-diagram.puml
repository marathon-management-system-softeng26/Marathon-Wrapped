@startuml
skinparam backgroundColor #FAF6EB
skinparam defaultFontName Helvetica
skinparam defaultFontColor #291B1D
skinparam shadowing false
skinparam ArrowColor #BA3143
skinparam activityBackgroundColor white
skinparam activityBorderColor #BA3143
skinparam activityDiamondBackgroundColor #D8F24B
skinparam activityDiamondBorderColor #291B1D
skinparam classBackgroundColor white
skinparam classBorderColor #BA3143
skinparam classAttributeIconSize 0
skinparam sequenceParticipantBackgroundColor white
skinparam sequenceParticipantBorderColor #BA3143
skinparam sequenceLifeLineBorderColor #291B1D
skinparam sequenceGroupBackgroundColor white
skinparam sequenceGroupBorderColor #BA3143
skinparam rectangleBackgroundColor white
skinparam rectangleBorderColor #BA3143
skinparam noteBackgroundColor #FFFDF6
skinparam noteBorderColor #BA3143
title View and export a personal race recap — UML activity
|Runner|
start
:Select runner or enter BIB;
|Marathon Wrapped|
:Look up selected runner and result;
if (Runner and result available?) then (yes)
  if (Known DNF?) then (yes)
    :Prepare DNF recap\nOmit finish time and finish pace;
  else (no)
    if (Valid finisher timing?) then (yes)
      :Prepare timing, pace and ranks\nExplain available splits;
    else (no)
      :Show result-unavailable state\nOffer retry or runner selection;
      stop
    endif
  endif
else (no)
  :Show result-unavailable state\nOffer retry or runner selection;
  stop
endif
:Load photos matched by BIB\nShow gallery or no-photo state;
:Render baseline recap\nInclude available stored optional metrics;
|Runner|
if (Choose to connect Strava?) then (yes)
  :Select Connect;
  |Strava|
  :Request runner authorization;
  |Runner|
  if (Authorize access?) then (yes)
    |Marathon Wrapped|
    :Request available race metrics;
    |Strava|
    :Return available metrics or failure;
    |Marathon Wrapped|
    :Add returned values when available\nKeep baseline usable on failure;
  else (no)
    |Marathon Wrapped|
    :Keep baseline recap available;
  endif
else (skip)
endif
|Runner|
:View personal recap;
if (Choose image export?) then (yes)
  |Marathon Wrapped|
  :Generate image from rendered recap;
  if (Image generated?) then (yes)
    |Runner|
    :Save image\nShare through chosen service if desired;
  else (no)
    |Marathon Wrapped|
    :Show actionable export error\nKeep recap and stored results intact;
  endif
else (no)
endif
|Runner|
stop
legend bottom
FR-01–FR-15. Main journey shown; disconnect is specified in FR-10.
DNS and invalid timing must not be assumed to mean DNF (OD-01).
endlegend
@enduml
