# Supabase — from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_URL=your-project-url-here
# Server-only secret key preferred; legacy service_role is also supported.
SUPABASE_SECRET_KEY=your-secret-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key-here

# Explicit opt-in for the dedicated demo project's seed/Auth/test workflow.
SUPABASE_DEMO_PROJECT_REF=your-demo-project-ref
# Optional strong demo password; otherwise seed:users generates one into the
# ignored .env.demo.local file without logging it.
# DEMO_PASSWORD=your-locally-chosen-demo-password

# Strava V3 API — from your Strava API application settings
# https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your-client-id-here
STRAVA_CLIENT_SECRET=your-client-secret-here
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
